# Caddy сам получает и продлевает HTTPS-сертификат Let's Encrypt для домена.
{
	email {$ACME_EMAIL}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 10MB
	}

	# Загруженные аватары отдаём напрямую, без выполнения чего-либо
	handle_path /media/* {
		root * /srv/media
		header {
			X-Content-Type-Options nosniff
			Content-Security-Policy "default-src 'none'; img-src 'self'; sandbox"
			Cache-Control "public, max-age=86400"
		}
		file_server
	}

	handle {
		reverse_proxy web:8000
	}

	header {
		-Server
	}

	log {
		output stdout
		format console
	}
}
