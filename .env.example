# Скопируйте этот файл в .env и заполните. Файл .env никому не показывайте
# и не загружайте в git — он уже в .gitignore.

# --- Основное ---
# Для компьютера разработчика: DEBUG=True. На сервере: DEBUG=False.
DEBUG=True
# Длинная случайная строка. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
# На сервере: CSRF_TRUSTED_ORIGINS=https://eslovari.ru,https://www.eslovari.ru
CSRF_TRUSTED_ORIGINS=
SITE_DOMAIN=eslovari.ru

# --- Админка ---
# Секретный адрес панели наполнения, например: ADMIN_URL=panel-7f3k2
ADMIN_URL=admin
# Пускать сотрудников в админку только с включённой 2FA (рекомендуется на сервере)
ADMIN_REQUIRE_2FA=False

# --- База данных ---
# По умолчанию SQLite (файл db.sqlite3). Для сервера — postgresql.
DB_ENGINE=sqlite
DB_NAME=eslovari
DB_USER=eslovari
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Только для сервера (docker-compose.prod.yml) ---
# Домен без https:// и без www
DOMAIN=eslovari.ru
# Сколько процессов обслуживают сайт: 2 для сервера с 512 МБ – 1 ГБ, 3–4 для 2 ГБ+
WEB_CONCURRENCY=2

# --- Защита входа ---
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1
SIGNUP_LIMIT_PER_HOUR=5

# --- Почта (восстановление пароля) ---
# Локально письма печатаются в консоль. Для сервера, например Яндекс 360:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=noreply@eslovari.ru
# EMAIL_HOST_PASSWORD=пароль-приложения
# DEFAULT_FROM_EMAIL=eSlovari <noreply@eslovari.ru>

# --- Вход через Яндекс (необязательно) ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
